# ============================================================
# ESG Officials — Server Environment Template
# Copy this file to server/.env and fill in every value.
# NEVER commit server/.env to version control.
# ============================================================

# Express server port
PORT=5000

# ---- MongoDB Atlas ----------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg-official-clients?retryWrites=true&w=majority
# Security note: In MongoDB Atlas Network Access, ensure Render's outbound IPs or your server IP are whitelisted.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg-official-clients?retryWrites=true&w=majority&appName=Cluster0

# ---- JWT Secret -------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_hex_string

# ---- Admin Auto-Provisioning Bootstrap (Optional) --------
# If defined, the server will ensure an active administrator exists on startup.
# To trigger a password sync, set SYNC_ADMIN_PASSWORD=true
ADMIN_EMAIL=admin@esgofficial.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME=ESG Administrator
SYNC_ADMIN_PASSWORD=false

# ---- Manager Auto-Provisioning Bootstrap (Optional) ------
# If defined, the server will ensure an active Manager exists on startup.
# To trigger a password sync, set SYNC_MANAGER_PASSWORD=true
MANAGER_EMAIL=rahul.manager@esgofficial.com
MANAGER_PASSWORD=your_strong_manager_password_here
MANAGER_NAME=Rahul Sharma
SYNC_MANAGER_PASSWORD=false

# ---- Resend (email delivery) ------------------------------
# Create an API key at https://resend.com/api-keys (keep it only in server/.env).
RESEND_API_KEY=re_your_resend_api_key
# Sender on a domain VERIFIED in Resend (Domains page). Gmail/Outlook addresses
# cannot be used as the sender. For testing only, ESG Officials <onboarding@resend.dev>
# works but Resend then delivers only to your Resend account's own email.
EMAIL_FROM=ESG Officials <no-reply@your-verified-domain.com>
# Optional, testing only: refuse every email except to this one address.
# Leave empty in production.
EMAIL_TEST_RECIPIENT=
# One-time codes (login, password reset, account verification)
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
CONTACT_RECEIVER_EMAIL=your_email@example.com

# ---- Cloudinary (document/file uploads) ------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS & Allowed Origins -------------------------------
# In production on Render, set CLIENT_URL or ALLOWED_ORIGINS to your Vercel domain.
# Localhost and *.vercel.app are automatically permitted by the server's origin matcher.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=https://esg-officials.vercel.app,http://localhost:5173
STATIC_SITE_URL=http://localhost:5500

# ============================================================
# SALES PLANNER: reminders, escalations, WhatsApp
# ============================================================
# Public URL of the frontend, used for "Open task" links in reminders
APP_BASE_URL=https://esg-officials.vercel.app

# Reminder lead time (hours before the scheduled time) and escalation delay
# (hours after the deadline / escalation start). Defaults: 24 and 24.
REMINDER_LEAD_HOURS=24
ESCALATION_HOURS=24

# Quarter definition for the Quarterly Planner: 1 = calendar quarters (Q1 = Jan-Mar),
# 4 = Indian financial year (Q1 = Apr-Jun)
QUARTER_START_MONTH=1

# In-process scheduler (runs every PLANNER_SCHEDULER_INTERVAL_MS while the API is awake)
PLANNER_SCHEDULER_ENABLED=true
PLANNER_SCHEDULER_INTERVAL_MS=60000

# External cron trigger: POST /api/planner/cron/run with header "X-Cron-Secret: <value>"
# Required when the host can sleep (e.g. Render free plan). Min 16 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---- WhatsApp Business Platform (Cloud API) ---------------
# From Meta for Developers > your app > WhatsApp > API Setup.
# Use a PERMANENT System User token (not the 24-hour test token).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved message template names and language code (must match WhatsApp Manager exactly)
WHATSAPP_REMINDER_TEMPLATE=upload_reminder
WHATSAPP_ESCALATION_TEMPLATE=task_escalation
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true
WHATSAPP_TEMPLATE_LANGUAGE=en
# "named" for templates that use {{business_name}}-style variables, "positional" for {{1}}, {{2}}...
WHATSAPP_TEMPLATE_PARAM_FORMAT=named
# Webhook (delivery receipts): callback URL https://<api-host>/api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Integration tests only (never production) -------------
# MONGO_URI_TEST=mongodb+srv://.../?retryWrites=true
# MONGO_TEST_DB=esg_planner_test

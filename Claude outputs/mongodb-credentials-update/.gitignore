# ============================================================
# Root .gitignore — covers both sub-projects
# ============================================================

# Environment files — NEVER commit these
**/.env
**/.env.local
**/.env.production
**/.env.*
!**/.env.example
**/*.pem
**/*.key

# Local database exports (contain user records)
**/backups/

# Dependencies
**/node_modules/

# Build output
**/dist/
**/dist-ssr/
**/.vite/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
# ESG Officials — Server Environment Template
# Copy this file to server/.env and fill in every value.
# NEVER commit server/.env to version control.
# ============================================================

# Express server port
PORT=5000

# ---- MongoDB Atlas ----------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg-official-clients?retryWrites=true&w=majority
# Security note: In MongoDB Atlas Network Access, ensure Render's outbound IPs or your server IP are whitelisted.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg-official-clients?retryWrites=true&w=majority&appName=Cluster0

# ---- JWT Secret -------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_hex_string

# ---- Admin Auto-Provisioning Bootstrap (Optional) --------
# If defined, the server will ensure an active administrator exists on startup.
# To trigger a password sync, set SYNC_ADMIN_PASSWORD=true
ADMIN_EMAIL=admin@esgofficial.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME=ESG Administrator
SYNC_ADMIN_PASSWORD=false

# ---- Resend (email delivery) ------------------------------
# Sign up at https://resend.com and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=ESG Officials <noreply@yourdomain.com>
CONTACT_RECEIVER_EMAIL=your_email@example.com

# ---- Cloudinary (document/file uploads) ------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS & Allowed Origins -------------------------------
# In production on Render, set CLIENT_URL or ALLOWED_ORIGINS to your Vercel domain.
# Localhost and *.vercel.app are automatically permitted by the server's origin matcher.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=https://esg-officials.vercel.app,http://localhost:5173
STATIC_SITE_URL=http://localhost:5500

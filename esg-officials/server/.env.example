# ============================================================
# ESG Officials — Server Environment Template
# Copy this file to server/.env and fill in every value.
# NEVER commit server/.env to version control.
# ============================================================

# Express server port
PORT=5000

# ---- MongoDB Atlas ----------------------------------------
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# The database name (esg-official-clients) can also be set via Mongoose dbName option in index.js.
# Steps:
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Add a database user with readWrite access
#   3. Whitelist your server IP (or 0.0.0.0/0 for all IPs)
#   4. Click Connect → Drivers → copy the connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg-official-clients?retryWrites=true&w=majority&appName=Cluster0

# ---- JWT Secret -------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_hex_string

# ---- Resend (email delivery) ------------------------------
# Sign up at https://resend.com and create an API key.
# DOMAIN VERIFICATION: To send email to any address you must verify a domain
# in the Resend dashboard. Without verification only the Resend test sender
# (onboarding@resend.dev) is available, restricted to your own account email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must use a domain you have verified in Resend.
# Example: "ESG Officials <noreply@yourdomain.com>"
# Omit or leave as default to use onboarding@resend.dev (testing only).
EMAIL_FROM=ESG Officials <noreply@yourdomain.com>

# Email address that receives consultation form submissions from the marketing site
CONTACT_RECEIVER_EMAIL=your_email@example.com

# ---- Cloudinary (document/file uploads) ------------------
# Sign up at https://cloudinary.com (free tier available).
# Copy values from Dashboard → Account Details.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS (allowed frontend origins) ---------------------
# Set to the URL where your React portal is served.
# Separate origins cannot be combined — use one per variable.
CLIENT_URL=http://localhost:5173
# URL of the static HTML marketing website (esgofficial/)
STATIC_SITE_URL=http://localhost:5500
